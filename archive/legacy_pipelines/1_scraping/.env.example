# Kredensial Akun X (Twitter) Dummy
# Anda bisa mengisi username, email, dan password untuk login otomatis
X_USERNAME=your_x_username
X_EMAIL=your_x_email
X_PASSWORD=your_x_password

# ATAU jika menggunakan cookie browser (rekomendasi agar lebih aman dari captcha)
# Dapatkan auth_token dan ct0 dari Developer Tools Browser (Application > Cookies > twitter.com / x.com)
X_AUTH_TOKEN=your_auth_token_here
X_CT0=your_ct0_here
